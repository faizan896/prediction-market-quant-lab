# Copy to .env.local for local dev.
#
# Local:      http://127.0.0.1:8000
# Production: set this in the Vercel dashboard to your deployed API URL,
#             e.g. https://quantlab-api.onrender.com
#
# It is NEXT_PUBLIC_* because the browser calls the API directly, which means
# the value is visible in the bundle. That is fine — there are no secrets in it,
# and every endpoint is read-only market research.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
