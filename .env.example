# Copy to .env. Every value is optional — market data on both venues is public.

# --- storage ---------------------------------------------------------------
QUANTLAB_DATA_DIR=./data
# Leave empty for SQLite. Set to switch to Postgres:
# QUANTLAB_DB_URL=postgresql://user:pass@localhost:5432/quantlab

# --- api / deployment -------------------------------------------------------
# Origins allowed to call the API. In production add your Vercel domain:
#   QUANTLAB_CORS_ORIGINS=https://your-app.vercel.app
QUANTLAB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Most PaaS platforms inject $PORT and override this.
QUANTLAB_PORT=8000

# --- http ------------------------------------------------------------------
QUANTLAB_HTTP_TIMEOUT=30
QUANTLAB_HTTP_RETRIES=3
QUANTLAB_RATE_LIMIT_RPS=8

# --- venues (defaults are correct; override only if they move) -------------
# QUANTLAB_POLYMARKET_GAMMA=https://gamma-api.polymarket.com
# QUANTLAB_POLYMARKET_CLOB=https://clob.polymarket.com
# QUANTLAB_KALSHI_API=https://api.elections.kalshi.com/trade-api/v2

# --- trading credentials (NOT needed for research) -------------------------
# Kalshi signs requests with RSA-PSS; generate a key pair in your account.
# QUANTLAB_KALSHI_KEY_ID=
# QUANTLAB_KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi.pem
#
# Polymarket derives API creds from a Polygon wallet private key via
# py-clob-client. Never put that key in this file.
